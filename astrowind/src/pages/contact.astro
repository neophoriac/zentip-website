---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Let's Connect!" />

  <ContactUs
    id="form"
    formId="zentip-contact-form"
    action="https://formspree.io/f/mbdnprgv"
    method="POST"
    title="How can we help?"
    subtitle="Tell us what you need and your message will be delivered to the Zentip support inbox."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        autocomplete: 'name',
        required: true,
        maxLength: 100,
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        autocomplete: 'email',
        required: true,
        maxLength: 254,
      },
      {
        type: 'select',
        name: 'subject',
        label: 'What would you like to tell us about?',
        placeholder: 'Choose a topic',
        required: true,
        options: [
          {
            value: 'Zentip technical support',
            label: 'Get technical support',
          },
          {
            value: 'Zentip bug report',
            label: 'Report a bug',
          },
          {
            value: 'Zentip feature suggestion',
            label: 'Suggest a feature',
          },
          {
            value: 'Zentip account or billing question',
            label: 'Ask about an account or billing',
          },
          {
            value: 'General Zentip question',
            label: 'Ask something else',
          },
        ],
      },
    ]}
    textarea={{
      label: 'Message',
      name: 'message',
      placeholder: 'Describe what happened, what you expected, and any steps that may help us reproduce the issue.',
      rows: 6,
      required: true,
      minLength: 10,
      maxLength: 5000,
    }}
    disclaimer={{
      label: 'I have not included passwords, payment details, or private Zendesk ticket content.',
      required: true,
    }}
    button="Send to Zentip support"
    description="Submissions are delivered to support@zentip.org through Formspree."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Find the right help"
    columns={3}
    items={[
      {
        title: 'Read the documentation',
        description: 'Learn how to set up Zentip, manage ticket views, configure notifications, and connect webhooks.',
        icon: 'tabler:book-2',
        callToAction: {
          text: 'Open documentation',
          href: '/documentation',
          variant: 'link',
        },
      },
      {
        title: 'Check common questions',
        description: 'The FAQ covers Zendesk access, sessions, privacy, subscriptions, and other frequent questions.',
        icon: 'tabler:help-circle',
        callToAction: {
          text: 'Browse the FAQ',
          href: '/faq',
          variant: 'link',
        },
      },
      {
        title: 'Email support',
        description: 'Prefer email? You can contact the same support inbox directly at support@zentip.org.',
        icon: 'tabler:mail',
        callToAction: {
          text: 'Email support@zentip.org',
          href: 'mailto:support@zentip.org',
          variant: 'link',
        },
      },
    ]}
  />
</Layout>
