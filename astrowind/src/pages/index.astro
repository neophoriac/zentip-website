---
import CallToAction from '~/components/widgets/CallToAction.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Features from '~/components/widgets/Features.astro';
import Hero from '~/components/widgets/Hero.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';
import popupDark from '~/assets/images/popup/main-dark.png';
import popupLight from '~/assets/images/popup/main-light.png';

const metadata = {
  title: 'Never miss a new reply or ticket',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Read the documentation',
        href: getPermalink('/documentation'),
      },
      {
        text: 'View FAQs',
        href: getPermalink('/faq'),
      },
    ]}
  >
    <Fragment slot="title">
      Never miss a <span class="text-accent dark:text-white">new reply or ticket</span>.
    </Fragment>

    <Fragment slot="subtitle">
      Zentip keeps an eye on the activity that matters to you and sends a native Windows notification through Chrome
      when something new arrives. Start with a 7-day free trial; a monthly or annual subscription is required afterward.
    </Fragment>

    <Fragment slot="image">
      <div
        class="mx-auto w-[751px] max-w-full box-content p-3 rounded-lg border-[1px] border-solid border-gray-200 shadow-lg dark:bg-gray-200/5 dark:border-green-900"
      >
        <div class="overflow-hidden rounded-lg">
          <img
            src={popupLight.src}
            width={popupLight.width}
            height={popupLight.height}
            class="block h-auto w-full dark:hidden"
            alt="Zentip extension popup showing the ticket list in light mode"
            loading="eager"
            fetchpriority="high"
          />
          <img
            src={popupDark.src}
            width={popupDark.width}
            height={popupDark.height}
            class="hidden h-auto w-full dark:block"
            alt="Zentip extension popup showing the ticket list in dark mode"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </Fragment>
  </Hero>

  <Features
    id="features"
    tagline="Stay informed"
    title="Updates, without constantly checking"
    subtitle="Zentip makes it easier to stay on top of new activity while you focus on everything else."
    items={[
      {
        title: 'Native notifications',
        description: 'Receive familiar Windows notifications created directly through Chrome.',
        icon: 'tabler:bell',
      },
      {
        title: 'Timely updates',
        description: 'Know about new replies and tickets as soon as Zentip finds them.',
        icon: 'tabler:clock',
      },
      {
        title: 'Integrated ticket viewer',
        description: 'Catch up on your tickets with our native ticket viewer.',
        icon: 'tabler:focus-2',
      },
      {
        title: 'Notifications menu',
        description: 'See all your notifications in one place with the notifications menu.',
        icon: 'tabler:menu',
      },
      {
        title: 'Webhook integration',
        description:
          'Optionally send selected ticket alerts directly from Chrome to your Slack, Microsoft Teams, or Discord webhook.',
        icon: 'tabler:link',
      },
      {
        title: 'Your data stays private',
        description:
          'Zentip does not send your Zendesk data, ticket content, browsing activity, or notifications to our servers. Optional webhook and billing providers handle only the data described in our Privacy Policy.',
        icon: 'tabler:shield-lock',
      },
    ]}
  />

  <Pricing
    tagline="Simple pricing"
    title="Choose the plan that works for you"
    subtitle="Start a free trial or choose a plan in Zentip. You can cancel at any time through ExtensionPay."
    currency="€"
    prices={[
      {
        title: 'Monthly',
        subtitle: 'Flexible monthly access',
        price: '3',
        period: 'per month',
        items: [
          { description: 'Renews automatically each month' },
          { description: 'Cancel any time through ExtensionPay' },
          { description: 'Access continues until the end of your billing period' },
        ],
      },
      {
        title: 'Annual',
        subtitle: 'Save €11 compared with monthly billing',
        price: '25',
        period: 'per year',
        hasRibbon: true,
        ribbonTitle: 'Best value',
        items: [
          { description: 'About €2.08 per month' },
          { description: 'Renews automatically each year' },
          { description: 'Cancel any time through ExtensionPay' },
          { description: 'Access continues until the end of your billing period' },
        ],
      },
    ]}
  />

  <FAQs
    title="Questions before you begin?"
    subtitle="Find more answers in the Zentip FAQ."
    items={[
      {
        title: 'What does Zentip notify me about?',
        description:
          'Zentip notifies you when it finds a new reply or ticket in the activity you have chosen to monitor.',
      },
      {
        title: 'How are notifications shown?',
        description: 'Zentip uses Chrome to create native Windows notifications.',
      },
      {
        title: 'Where can I get help?',
        description: 'Visit the documentation for guidance, browse the FAQ, or contact us for support.',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Explore the documentation',
        href: getPermalink('/documentation'),
      },
    ]}
  >
    <Fragment slot="title">Stay up to date with Zentip.</Fragment>
    <Fragment slot="subtitle">Everything you need to get started is in the documentation.</Fragment>
  </CallToAction>
</Layout>
