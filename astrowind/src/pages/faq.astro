---
import HeroText from '~/components/widgets/HeroText.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Frequently asked questions',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Support"
    title="Frequently asked questions"
    subtitle="Find answers to common questions about Zentip."
  />

  <FAQs
    title="Zentip FAQs"
    subtitle="Answers to common questions about setup, notifications, and billing."
    items={[
      {
        title: 'What does Zentip notify me about?',
        description:
          'Zentip notifies you when it finds a new reply or ticket in the activity you have chosen to monitor.',
      },
      {
        title: 'Do I need to be logged in to Zendesk?',
        description:
          "Yes. Zentip is currently designed as a companion for employees who already have access to Zendesk, so it uses your active Zendesk browser session. Registering a local OAuth client in Zendesk requires administrative access, which an employee may not have. Because Zentip only has the access granted to the employee's existing session, signing out or losing access to Zendesk also removes Zentip's access.",
      },
      {
        title: 'Is Zentip subscription-based?',
        description:
          'Yes. Zentip includes a 7-day free trial with no payment card required. A monthly or annual subscription is required to continue using the extension after the trial.',
      },
      {
        title: 'How much does Zentip cost?',
        description:
          'Zentip costs €3 per month or €25 per year. The annual plan saves €11 compared with paying monthly for a full year.',
      },
      {
        title: 'Is a payment card required to start a trial?',
        description: 'No. You can start a Zentip trial without a payment card.',
      },
      {
        title: 'Do subscriptions renew automatically?',
        description:
          'Yes. Monthly subscriptions renew each month, and annual subscriptions renew each year unless you cancel.',
      },
      {
        title: 'How do I cancel my subscription?',
        description: 'You can cancel your subscription through ExtensionPay.',
      },
      {
        title: 'What happens when I cancel?',
        description: 'Your subscription remains active until the end of your current billing period.',
      },
      {
        title: 'Can I request a refund?',
        description:
          'You can request a full refund of your first subscription payment within 14 days. Duplicate or incorrect charges and material technical problems are also reviewed. See the <a class="font-medium text-primary hover:underline" href="/refund-policy">Refund and Cancellation Policy</a> for the complete terms.',
      },
    ]}
  />
</Layout>
