---
import favIcon from '~/assets/favicons/favicon.svg';
import zentipLogo from '~/assets/brand/zentip.svg';
---

<span class="flex items-center gap-2 self-center whitespace-nowrap">
  <img src={favIcon.src} width="48" height="48" alt="" aria-hidden="true" />
  <img src={zentipLogo.src} width="419" height="143" alt="Zentip" class="h-7 w-auto text-gray-900 dark:invert md:h-6" />
</span>
