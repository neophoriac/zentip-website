---
import type { ImageMetadata } from 'astro';

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  lightAlt: string;
  darkAlt: string;
  caption?: string;
}

const { light, dark, lightAlt, darkAlt, caption } = Astro.props;
const naturalWidth = Math.min(light.width, dark.width);
const displayWidth = Math.min(naturalWidth, 850);
const aspectRatio = `${light.width} / ${light.height}`;
---

<figure class="not-prose mt-6">
  <div
    class="theme-comparison relative mx-auto w-full touch-none select-none overflow-hidden rounded-xl border border-green-200 bg-green-950 shadow-sm dark:border-green-800"
    style={`--comparison-position: 50%; max-width: ${displayWidth}px; aspect-ratio: ${aspectRatio}`}
    data-theme-comparison
  >
    <img
      src={dark.src}
      width={dark.width}
      height={dark.height}
      alt={darkAlt}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <img
      src={light.src}
      width={light.width}
      height={light.height}
      alt={lightAlt}
      loading="lazy"
      decoding="async"
      class="comparison-light absolute inset-0 h-full w-full object-cover"
    />

    <span
      class="pointer-events-none absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-slate-900 shadow-sm"
      aria-hidden="true">Light</span
    >
    <span
      class="pointer-events-none absolute right-3 top-3 rounded-full bg-slate-950/85 px-2.5 py-1 text-xs font-semibold text-white shadow-sm"
      aria-hidden="true">Dark</span
    >

    <div
      class="comparison-divider pointer-events-none absolute inset-y-0 z-10 w-0.5 bg-white shadow-md"
      aria-hidden="true"
    >
      <span
        class="absolute left-1/2 top-1/2 grid h-10 w-10 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-2 border-white bg-slate-900 text-white shadow-lg"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m9 18-6-6 6-6M15 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>

    <input
      class="comparison-range absolute inset-0 z-20 h-full w-full cursor-ew-resize opacity-0"
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label="Adjust the light and dark theme comparison"
      aria-valuetext="50% light theme and 50% dark theme"
    />
  </div>
  <p class="mt-3 text-center text-sm text-muted">Drag the divider, or focus it and use the arrow keys.</p>
  {caption && <figcaption class="mx-auto mt-1 max-w-3xl text-center text-sm text-muted">{caption}</figcaption>}
</figure>

<script>
  const initializeThemeComparisons = () => {
    document.querySelectorAll<HTMLElement>('[data-theme-comparison]').forEach((comparison) => {
      if (comparison.dataset.initialized === 'true') return;

      const range = comparison.querySelector<HTMLInputElement>('.comparison-range');
      if (!range) return;

      const update = () => {
        const value = Number(range.value);
        comparison.style.setProperty('--comparison-position', `${value}%`);
        range.setAttribute('aria-valuetext', `${value}% light theme and ${100 - value}% dark theme`);
      };

      range.addEventListener('input', update);
      update();
      comparison.dataset.initialized = 'true';
    });
  };

  initializeThemeComparisons();
  document.addEventListener('astro:page-load', initializeThemeComparisons);
</script>

<style>
  .comparison-light {
    clip-path: inset(0 calc(100% - var(--comparison-position)) 0 0);
  }

  .comparison-divider {
    left: var(--comparison-position);
  }

  .comparison-light,
  .comparison-divider {
    transition:
      clip-path 80ms linear,
      left 80ms linear;
  }

  .theme-comparison:focus-within {
    outline: 3px solid var(--aw-color-primary);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .comparison-light,
    .comparison-divider {
      transition: none;
    }
  }
</style>
