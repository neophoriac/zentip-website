---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';

const {
  inputs,
  textarea,
  disclaimer,
  button = 'Send message',
  description = '',
  action,
  method = 'POST',
  formId = 'contact-form',
  hiddenInputs = [],
  formKind = 'default',
  turnstileSiteKey,
  turnstileAction = 'contact',
  successMessage = 'Thanks! Your message has been sent to Zentip support.',
  errorMessage = 'Sorry, we could not send your message. Please try again or email support@zentip.org.',
} = Astro.props;

const statusId = `${formId}-status`;
---

<form
  id={formId}
  action={action}
  method={method}
  data-enhanced-form={action ? 'true' : undefined}
  data-form-kind={formKind}
>
  {hiddenInputs.map(({ name, value }) => <input type="hidden" name={name} value={value} />)}

  <div class="absolute -left-[10000px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
    <label for={`${formId}-company`}>Leave this field empty</label>
    <input id={`${formId}-company`} type="text" name="honeypot" tabindex="-1" autocomplete="off" />
  </div>

  {
    inputs &&
      inputs.map(
        ({
          type = 'text',
          name,
          label = '',
          autocomplete = 'on',
          placeholder = '',
          required = false,
          maxLength,
          options = [],
        }) =>
          name && (
            <div class="mb-6">
              {label && (
                <label for={name} class="block text-sm font-medium">
                  {label}
                  {required && (
                    <span class="ml-1 text-red-600 dark:text-red-400" aria-hidden="true">
                      *
                    </span>
                  )}
                </label>
              )}
              {type === 'select' ? (
                <select
                  name={name}
                  id={name}
                  required={required}
                  class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-green-700 bg-white dark:bg-green-950"
                >
                  <option value="" disabled selected>
                    {placeholder || 'Select an option'}
                  </option>
                  {options.map(({ label: optionLabel, value }) => (
                    <option value={value}>{optionLabel}</option>
                  ))}
                </select>
              ) : (
                <input
                  type={type}
                  name={name}
                  id={name}
                  autocomplete={autocomplete}
                  placeholder={placeholder}
                  required={required}
                  maxlength={maxLength}
                  class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-green-700 bg-white dark:bg-green-950"
                />
              )}
            </div>
          )
      )
  }

  {
    textarea && (
      <div>
        <label for="textarea" class="block text-sm font-medium">
          {textarea.label}
          {textarea.required && (
            <span class="ml-1 text-red-600 dark:text-red-400" aria-hidden="true">
              *
            </span>
          )}
        </label>
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          required={textarea.required}
          minlength={textarea.minLength}
          maxlength={textarea.maxLength}
          class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-green-700 bg-white dark:bg-green-950"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            required={disclaimer.required}
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-green-700 bg-white dark:bg-slate-900"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
            {disclaimer.label}
            {disclaimer.required && (
              <span class="ml-1 text-red-600 dark:text-red-400" aria-hidden="true">
                *
              </span>
            )}
          </label>
        </div>
      </div>
    )
  }

  {
    turnstileSiteKey && (
      <div class="mt-6">
        <div
          class="min-h-[65px]"
          data-turnstile
          data-turnstile-site-key={turnstileSiteKey}
          data-turnstile-action={turnstileAction}
          aria-label="Spam protection verification"
        />
        <noscript>
          <p class="mt-2 text-sm text-red-700 dark:text-red-300">
            JavaScript is required to verify and submit this form. You can email support@zentip.org instead.
          </p>
        </noscript>
      </div>
    )
  }

  {
    button && (
      <div class="mt-10 grid">
        <Button variant="primary" type="submit" data-form-submit aria-describedby={statusId}>
          {button}
        </Button>
      </div>
    )
  }

  <p
    id={statusId}
    class="mt-4 hidden rounded-lg border px-4 py-3 text-sm"
    role="status"
    aria-live="polite"
    data-form-status
    data-success-message={successMessage}
    data-error-message={errorMessage}
  >
  </p>

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    )
  }
</form>

<script>
  type TurnstileApi = {
    render: (
      container: HTMLElement,
      options: {
        sitekey: string;
        action: string;
        theme: 'auto';
      }
    ) => string;
    reset: (widgetId: string) => void;
  };

  type FormResponse = {
    success?: boolean;
    message?: string;
    error?: string;
    errors?: Array<{ message?: string }> | Record<string, string | string[]>;
  };

  const turnstileWindow = window as typeof window & { turnstile?: TurnstileApi };
  let turnstileLoadPromise: Promise<TurnstileApi> | undefined;

  const loadTurnstile = () => {
    if (turnstileWindow.turnstile) return Promise.resolve(turnstileWindow.turnstile);
    if (turnstileLoadPromise) return turnstileLoadPromise;

    turnstileLoadPromise = new Promise<TurnstileApi>((resolve, reject) => {
      const existingScript = document.querySelector<HTMLScriptElement>('script[data-turnstile-script]');
      const script = existingScript || document.createElement('script');

      const handleLoad = () => {
        if (turnstileWindow.turnstile) {
          resolve(turnstileWindow.turnstile);
        } else {
          reject(new Error('The verification service did not load.'));
        }
      };

      const handleError = () => reject(new Error('The verification service could not be loaded.'));

      script.addEventListener('load', handleLoad, { once: true });
      script.addEventListener('error', handleError, { once: true });

      if (!existingScript) {
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        script.async = true;
        script.defer = true;
        script.dataset.turnstileScript = 'true';
        document.head.append(script);
      }
    });

    return turnstileLoadPromise;
  };

  const initializeEnhancedForms = () => {
    document.querySelectorAll<HTMLFormElement>('form[data-enhanced-form="true"]').forEach((form) => {
      if (form.dataset.initialized === 'true') return;
      form.dataset.initialized = 'true';

      const submitButton = form.querySelector<HTMLButtonElement>('[data-form-submit]');
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      if (!submitButton || !status) return;

      const buttonLabel = submitButton.textContent?.trim() || 'Send message';
      const successMessage = status.dataset.successMessage || 'Your message has been sent.';
      const defaultErrorMessage = status.dataset.errorMessage || 'Your message could not be sent.';

      const getResponseError = (result: FormResponse | null) => {
        if (!result) return '';
        if (result.message) return result.message;
        if (result.error) return result.error;
        if (Array.isArray(result.errors)) {
          return result.errors
            .map(({ message }) => message)
            .filter(Boolean)
            .join(' ');
        }
        if (result.errors) {
          return Object.values(result.errors)
            .flatMap((value) => (Array.isArray(value) ? value : [value]))
            .filter(Boolean)
            .join(' ');
        }
        return '';
      };

      const showStatus = (message: string, state: 'loading' | 'success' | 'error') => {
        status.textContent = message;
        status.classList.remove(
          'hidden',
          'border-gray-200',
          'bg-gray-50',
          'text-gray-700',
          'border-green-200',
          'bg-green-50',
          'text-green-800',
          'border-red-200',
          'bg-red-50',
          'text-red-800',
          'dark:border-green-800',
          'dark:bg-green-950',
          'dark:text-green-200',
          'dark:border-red-800',
          'dark:bg-red-950',
          'dark:text-red-200'
        );

        if (state === 'success') {
          status.classList.add(
            'border-green-200',
            'bg-green-50',
            'text-green-800',
            'dark:border-green-800',
            'dark:bg-green-950',
            'dark:text-green-200'
          );
        } else if (state === 'error') {
          status.classList.add(
            'border-red-200',
            'bg-red-50',
            'text-red-800',
            'dark:border-red-800',
            'dark:bg-red-950',
            'dark:text-red-200'
          );
        } else {
          status.classList.add('border-gray-200', 'bg-gray-50', 'text-gray-700');
        }
      };

      const turnstileContainer = form.querySelector<HTMLElement>('[data-turnstile]');

      if (turnstileContainer) {
        const sitekey = turnstileContainer.dataset.turnstileSiteKey;
        const action = turnstileContainer.dataset.turnstileAction || 'contact';

        if (sitekey) {
          loadTurnstile()
            .then((turnstile) => {
              if (!turnstileContainer.isConnected || turnstileContainer.dataset.turnstileWidgetId) return;

              turnstileContainer.dataset.turnstileWidgetId = turnstile.render(turnstileContainer, {
                sitekey,
                action,
                theme: 'auto',
              });
            })
            .catch(() => {
              showStatus(
                'Spam protection could not load. Please refresh the page or email support@zentip.org.',
                'error'
              );
            });
        }
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!form.reportValidity()) return;

        if (turnstileContainer) {
          const token = form.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]')?.value;
          if (!token) {
            showStatus('Please complete the spam protection check before sending your message.', 'error');
            return;
          }
        }

        submitButton.disabled = true;
        submitButton.textContent = 'Sending…';
        showStatus('Sending your message…', 'loading');

        try {
          const submissionData = new FormData(form);

          if (form.dataset.formKind === 'uninstall-feedback') {
            const reason = String(submissionData.get('reason') || '').trim();
            const comments = String(submissionData.get('message') || '').trim();
            const replyEmail = String(submissionData.get('replyEmail') || '').trim();

            submissionData.set('email', replyEmail || String(submissionData.get('email') || ''));
            submissionData.set(
              'message',
              [
                `Reason: ${reason}`,
                '',
                'Additional comments:',
                comments || 'No additional comments provided.',
                '',
                `Reply requested: ${replyEmail ? 'Yes' : 'No'}`,
              ].join('\n')
            );
            submissionData.delete('reason');
            submissionData.delete('replyEmail');
          }

          const response = await fetch(form.action, {
            method: form.method,
            body: submissionData,
            headers: {
              Accept: 'application/json',
            },
          });

          const result = (await response.json().catch(() => null)) as FormResponse | null;

          if (!response.ok || result?.success === false) {
            throw new Error(getResponseError(result) || defaultErrorMessage);
          }

          form.reset();
          showStatus(successMessage, 'success');
        } catch (error) {
          showStatus(error instanceof Error ? error.message : defaultErrorMessage, 'error');
        } finally {
          const widgetId = turnstileContainer?.dataset.turnstileWidgetId;
          if (widgetId && turnstileWindow.turnstile) {
            turnstileWindow.turnstile.reset(widgetId);
          }

          submitButton.disabled = false;
          submitButton.textContent = buttonLabel;
        }
      });
    });
  };

  initializeEnhancedForms();
  document.addEventListener('astro:page-load', initializeEnhancedForms);
</script>
